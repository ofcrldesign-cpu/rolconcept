# ==============================================================================
# ROL CONCEPT — Variáveis de Ambiente e Configurações (.env.example)
# ==============================================================================
# IMPORTANTE:
# Este projeto utiliza stack Vanilla (HTML5 semântico, CSS3 e JavaScript ES6 puro).
# No momento, a aplicação é 100% estática e não expõe credenciais sensíveis no frontend.
#
# Caso sejam integrados serviços de backend, webhooks ou automações no futuro,
# copie este arquivo para ".env" e preencha as variáveis correspondentes:
#
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no Git! O .gitignore já está configurado para protegê-lo.
# ==============================================================================

# Telefone de Atendimento WhatsApp (DDI + DDD + Número)
# Utilizado nos links dinâmicos de agendamento e atendimento
VITE_OR_PUBLIC_WHATSAPP_PHONE="5511985940916"

# Google Analytics 4 (GA4) / Google Tag Manager (GTM)
# Exemplo: G-XXXXXXXXXX ou GTM-XXXXXXX
PUBLIC_GA_MEASUREMENT_ID=""
PUBLIC_GTM_ID=""

# Google Maps Platform (Opcional - caso migrem do iframe gratuito para JavaScript Maps API)
# Exemplo: AIzaSy...
GOOGLE_MAPS_API_KEY=""

# Meta Pixel (Facebook Ads) - Opcional
PUBLIC_META_PIXEL_ID=""
